<div class="partner-logo-slider"  style="background:{{ section.settings.bg }}">
  <div class="partner-logo-slide">
    {% for block in section.blocks %}
        {% if block.settings.richtext != "" %}
        <span style="color:{{ section.settings.color }}">{{ block.settings.richtext | link_to: block.settings.link }}</span>
        {% endif %}
    {% endfor %}
  </div>
</div>
<style>
  .partner-logo-slider {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
  position: relative;
}

.partner-logo-slide span:hover {
  cursor: pointer;
  text-decoration: underline;
}

.partner-logo-slider::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 120px;
  height: 100%;
  z-index: 9;
}

.partner-logo-slider::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 120px;
  height: 100%;
  z-index: 9;
}

.partner-logo-slide {
  display: flex;
  align-items: center;
  gap: 20px;
  width: max-content;
  padding: 13px 0;

  animation-name: partner-logo;
  animation-duration: 15s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.partner-logo-slider:hover .partner-logo-slide {
  animation-play-state: paused;
}

.partner-logo-slide img {
  width: 150px;
  border: 1px solid #b2b2b2;
  padding: 20px;
  border-radius: 10px;
}

.marquee-spacer {
  width: 50vw;
  flex: 0 0 50vw;
}

@keyframes partner-logo {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(var(--marquee-distance));
  }
}

@media only screen and (max-width: 1025px) {
  .partner-logo-slide {
    gap: 20px;
  }

  .partner-logo-slide img {
    height: 45px;
  }
}

@media only screen and (max-width: 769px) {
  .partner-logo-slide {
    animation-duration: 10s;
  }
}
</style>
<script>
{% comment %} document.addEventListener("DOMContentLoaded", function () {
  const slides = document.querySelector(".partner-logo-slide");
  const cloneCount = 3;

  if (!slides) return;

  for (let i = 0; i < cloneCount; i++) {
    const children = Array.from(slides.children);

    children.forEach(child => {
      slides.appendChild(child.cloneNode(true));
    });
  }
}); {% endcomment %}

document.addEventListener("DOMContentLoaded", function () {
  const slides = document.querySelector(".partner-logo-slide");

  if (!slides || slides.dataset.init === "true") return;

  slides.dataset.init = "true";

  // Original items
  const originalItems = Array.from(slides.children);

  // ✅ Last item ke baad half screen space
  const spacer = document.createElement("div");
  spacer.classList.add("marquee-spacer");
  slides.appendChild(spacer);

  // ✅ Original items ko ek baar duplicate karo
  originalItems.forEach((item) => {
    slides.appendChild(item.cloneNode(true));
  });

  // ✅ Second spacer for seamless repeat
  const spacerClone = spacer.cloneNode(true);
  slides.appendChild(spacerClone);

  // First complete cycle ki width
  requestAnimationFrame(() => {
    let cycleWidth = 0;

    originalItems.forEach((item) => {
      cycleWidth += item.getBoundingClientRect().width;
    });

    const gap = 20;
    cycleWidth += gap * originalItems.length;
    cycleWidth += window.innerWidth / 2;

    slides.style.setProperty(
      "--marquee-distance",
      `-${cycleWidth}px`
    );
  });
});
</script>

{% schema %}
{
  "name": "Announcement bar marquee",
  "max_blocks": 10,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable marquee animation",
      "default": true
    },
    {
      "type": "color",
      "id": "color",
      "label": "Slider text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed (seconds)",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "textarea",
          "id": "richtext",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar marquee",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
